# Local Docker Compose defaults. On Render, use Atlas Connect > Drivers.
MONGODB_URI=mongodb://mongodb:27017
# MongoDB Atlas format: mongodb+srv://<user>:<encoded-password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=research_copilot

# Render injects REDIS_URI from its Key Value instance. External TLS uses rediss://.
REDIS_URI=redis://redis:6379/0
# Optional. Leave blank to share REDIS_URI, or set it to Redis DB 1 for local Compose.
REDIS_PUBSUB_URI=

# Supply actual provider credentials in your local .env or Render dashboard.
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Comma-separated browser origins. Set the exact HTTPS Vercel origin on Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOCK_LLM_FOR_LOAD_TEST=false
